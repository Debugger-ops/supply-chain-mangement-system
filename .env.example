# Redis driver: "raw" (default, zero-dependency, talks to REDIS_HOST/REDIS_PORT)
# or "ioredis" (recommended once you've run `npm install`; talks to REDIS_URL).
REDIS_DRIVER=raw
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379

# Leave unset to use the in-memory event bus (no infra needed). Set to a
# comma-separated broker list (e.g. from `docker compose up`) to use real Kafka.
KAFKA_BROKERS=localhost:9092

# Order storage: "memory" (default — resets on every restart, what the
# test suite uses) or "pg" (Postgres-backed via PgOrderStore, see
# docs/schema.sql — requires DATABASE_URL and the tables to already exist,
# which `docker compose up postgres` provisions automatically).
ORDER_STORE=memory
DATABASE_URL=postgres://app:app@localhost:5432/supply_chain

PORT=3000

# Signs the dashboard's login session cookie (src/auth/session.ts). If
# unset, a random secret is generated per-process (logged as a warning) —
# fine for local dev, but every restart invalidates existing sessions, so
# set a stable value for anything longer-lived.
SESSION_SECRET=
